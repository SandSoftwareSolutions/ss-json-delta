{
  "name": "@sandsoftwaresolutions/json-delta",
  "version": "0.1.1",
  "description": "JSON Patch (RFC 6902): the difference between two JSON documents, and applying it. Immutable, all-or-nothing, no prototype pollution.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "json",
    "patch",
    "diff",
    "rfc6902"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-json-delta.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-json-delta/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-json-delta#readme",
  "publishConfig": {
    "access": "public"
  }
}
